---
import Base from '../../layouts/Base.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);

const projects = (await reader.collections.projects.all())
  .filter((p) => !p.entry.draft)
  .sort((a, b) => (a.entry.date < b.entry.date ? 1 : -1));

// Projects show year and month: 2026.07
const fmt = (d: string) => d.slice(0, 7).replace('-', '.');
---

<Base title="Projects" description="Things Ryan Choi has built.">
  <div class="masthead">
    <h1>Projects</h1>
  </div>

  {projects.length === 0 ? (
    <p class="empty">Nothing here yet. Soon.</p>
  ) : (
    <ul class="ledger">
      {projects.map(({ slug, entry }) => (
        <li>
          <div class="ledger-body">
            <a class="ledger-title" href={`/projects/${slug}/`}>{entry.title}</a>
            {entry.summary && <span class="ledger-summary">{entry.summary}</span>}
          </div>
          <span class="ledger-date">{fmt(entry.date)}</span>
        </li>
      ))}
    </ul>
  )}
</Base>
