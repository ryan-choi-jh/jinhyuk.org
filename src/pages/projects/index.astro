---
/**
 * The projects index, from the metadata of `src/content/pages/projects/*.json`.
 *
 * Was the Keystatic reader over `src/content/projects/*.mdoc`. The markup, the
 * date format (2026.07, to the month), the `.ledger-summary` line and the
 * empty line are the renderer's now (src/cms/render/pages/ledger.ts).
 */
import Base from '../../layouts/Base.astro';
import { ledgerItemsFromMetas, renderLedgerPage } from '../../cms/render/index.ts';
import { projectMetas } from '../../lib/site-content.ts';

const body = renderLedgerPage(ledgerItemsFromMetas(projectMetas(), 'projects'), 'projects');
---

<Base title="Projects" description="Things Ryan Choi has built.">
  <Fragment set:html={body} />
</Base>
