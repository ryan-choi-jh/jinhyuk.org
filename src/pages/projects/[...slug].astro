---
import Base from '../../layouts/Base.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const projects = await reader.collections.projects.all();
  return projects
    .filter((p) => !p.entry.draft)
    .map((p) => ({ params: { slug: p.slug }, props: { project: p.entry } }));
}

const { project } = Astro.props;

const fmt = (d: string) =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

const prettyUrl = (url: string) => {
  try {
    const u = new URL(url);
    return (u.hostname.replace(/^www\./, '') + u.pathname).replace(/\/$/, '');
  } catch {
    return url;
  }
};

// Turn a pasted video link into what we need to embed it.
// Returns a YouTube/Vimeo iframe src, a direct file src, or null.
const embedFor = (url: string) => {
  try {
    const u = new URL(url);
    const host = u.hostname.replace(/^www\./, '');
    if (host === 'youtube.com' || host === 'm.youtube.com') {
      const id = u.searchParams.get('v');
      if (id) return { type: 'iframe', src: `https://www.youtube.com/embed/${id}` };
    }
    if (host === 'youtu.be') {
      const id = u.pathname.slice(1);
      if (id) return { type: 'iframe', src: `https://www.youtube.com/embed/${id}` };
    }
    if (host === 'vimeo.com') {
      const id = u.pathname.split('/').filter(Boolean)[0];
      if (id) return { type: 'iframe', src: `https://player.vimeo.com/video/${id}` };
    }
    if (/\.(mp4|webm|mov|ogg)$/i.test(u.pathname)) {
      return { type: 'file', src: url };
    }
  } catch {
    /* fall through */
  }
  return null;
};

const paragraphs = (text: string) =>
  text
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);
---

<Base title={project.title} description={project.summary || project.title}>
  <article class="project">
    <h1>{project.title}</h1>
    <p class="post-meta">{fmt(project.date)}</p>

    {project.url && (
      <a class="project-link" href={project.url} target="_blank" rel="noopener noreferrer">
        <span class="project-link-label">Visit</span>
        <span class="project-link-url">{prettyUrl(project.url)}</span>
        <svg class="project-link-arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M4.5 11.5 11.5 4.5M11.5 4.5H6M11.5 4.5V10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    )}

    {project.summary && <p class="lead project-lead">{project.summary}</p>}

    <div class="project-content">
      {project.blocks.map((block) => {
        if (block.discriminant === 'text') {
          return paragraphs(block.value).map((para) => <p>{para}</p>);
        }
        if (block.discriminant === 'image') {
          const { src, alt, caption } = block.value;
          if (!src) return null;
          return (
            <figure>
              <img src={src} alt={alt || ''} loading="lazy" />
              {caption && <figcaption>{caption}</figcaption>}
            </figure>
          );
        }
        if (block.discriminant === 'videoFile') {
          const { file, caption } = block.value;
          if (!file) return null;
          return (
            <figure>
              <video src={file} controls playsinline preload="metadata"></video>
              {caption && <figcaption>{caption}</figcaption>}
            </figure>
          );
        }
        if (block.discriminant === 'videoLink') {
          const { url, caption } = block.value;
          if (!url) return null;
          const embed = embedFor(url);
          return (
            <figure>
              {embed?.type === 'iframe' ? (
                <div class="video-frame">
                  <iframe
                    src={embed.src}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    title={caption || 'Embedded video'}
                  ></iframe>
                </div>
              ) : embed?.type === 'file' ? (
                <video src={embed.src} controls playsinline preload="metadata"></video>
              ) : (
                <a href={url} target="_blank" rel="noopener noreferrer">{url}</a>
              )}
              {caption && <figcaption>{caption}</figcaption>}
            </figure>
          );
        }
        return null;
      })}
    </div>
  </article>
</Base>
