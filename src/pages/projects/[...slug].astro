---
/**
 * One project page, from `src/content/pages/projects/<slug>.json`.
 *
 * Was `.mdoc` read through the Keystatic reader and rendered by
 * `src/lib/project-doc.ts`. The body is `renderDoc` now; the masthead above it
 * is still this page's own.
 *
 * The masthead is still NOT `renderDocHead`, for the reason it never was: a
 * project's "Visit" link is not an essay's. Live it is `.project-link`, a 13px
 * nav-face row on a hairline underline with an arrow glyph, where
 * `renderDocHead` emits `.doc-visit`, a 15px row with a bold label and no
 * arrow or rule. Flattening the two would change how this page looks.
 *
 * It is no longer written out HERE, though. It moved to
 * `src/cms/render/pages/project.ts`, element for element, because the editor
 * could not draw a masthead that only existed inside an Astro template: a
 * project opened in the CMS started at its first paragraph with the title,
 * date, link and summary missing. Same markup, two callers, nothing published
 * changed.
 *
 * The `.project-body` wrapper is gone: `.doc` is that box now, with the same
 * 8px of padding-top, and doc.css carries the measures and the link underlines
 * that `.project-body > p` used to.
 */
import Base from '../../layouts/Base.astro';
import '../../cms/styles/doc.css';
import { renderDoc, renderProjectHead } from '../../cms/render/index.ts';
import { projectDocs } from '../../lib/site-content.ts';

export async function getStaticPaths() {
  return projectDocs().map((doc) => ({ params: { slug: doc.meta.slug }, props: { doc } }));
}

const { doc } = Astro.props;
const { meta } = doc;
const head = renderProjectHead(doc);
const body = renderDoc(doc);
---

<Base title={meta.title} description={meta.summary || meta.title}>
  <Fragment set:html={head} />
  <Fragment set:html={body} />
</Base>

<script>
  import { initDocConnectors } from '../../cms/render/connectors.ts';
  import { initLightboxes } from '../../cms/render/lightbox.ts';
  initDocConnectors();
  // Click a figure to see it full-screen. The same overlay the homepage and
  // the albums use; a diagram drawn for the 1344px column is unreadable on a
  // phone otherwise.
  initLightboxes();
</script>
