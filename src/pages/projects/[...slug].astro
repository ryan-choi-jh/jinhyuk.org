---
/**
 * One project page, from `src/content/pages/projects/<slug>.json`.
 *
 * Was `.mdoc` read through the Keystatic reader and rendered by
 * `src/lib/project-doc.ts`. The body is `renderDoc` now; the masthead above it
 * is still this page's own.
 *
 * The masthead stays here deliberately. `renderDocHead` exists and the essay
 * page uses it, but a project's "Visit" link is not the same object: live it is
 * `.project-link`, a 13px nav-face row on a hairline underline with an arrow
 * glyph, and `renderDocHead` emits `.doc-visit`, a 15px row with a bold label
 * and no arrow or rule. Swapping it would change how this page looks, and the
 * cutover is a change of data source only. `renderDocHead` is explicitly
 * optional and not part of the renderer contract (docs/cms-contracts.md 4), so
 * a page is allowed to build its own header — this one does, out of `doc.meta`
 * instead of out of Keystatic's entry.
 *
 * The `.project-body` wrapper is gone: `.doc` is that box now, with the same
 * 8px of padding-top, and doc.css carries the measures and the link underlines
 * that `.project-body > p` used to.
 */
import Base from '../../layouts/Base.astro';
import '../../cms/styles/doc.css';
import { renderDoc } from '../../cms/render/index.ts';
import { projectDocs } from '../../lib/site-content.ts';

export async function getStaticPaths() {
  return projectDocs().map((doc) => ({ params: { slug: doc.meta.slug }, props: { doc } }));
}

const { doc } = Astro.props;
const { meta } = doc;
const body = renderDoc(doc);

const fmt = (d: string) =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

const prettyUrl = (url: string) => {
  try {
    const u = new URL(url);
    return (u.hostname.replace(/^www\./, '') + u.pathname).replace(/\/$/, '');
  } catch {
    return url;
  }
};
---

<Base title={meta.title} description={meta.summary || meta.title}>
  <article class="project">
    <h1>{meta.title}</h1>
    <p class="post-meta">{fmt(meta.date)}</p>

    {meta.url && (
      <a class="project-link" href={meta.url} target="_blank" rel="noopener noreferrer">
        <span class="project-link-label">Visit</span>
        <span class="project-link-url">{prettyUrl(meta.url)}</span>
        <svg class="project-link-arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M4.5 11.5 11.5 4.5M11.5 4.5H6M11.5 4.5V10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    )}

    {meta.summary && <p class="lead project-lead">{meta.summary}</p>}
  </article>

  <Fragment set:html={body} />
</Base>

<script>
  import { initDocConnectors } from '../../cms/render/connectors.ts';
  initDocConnectors();
</script>
