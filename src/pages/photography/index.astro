---
/**
 * The photography index, from `src/content/data/photography.json`.
 *
 * Was `src/data/photography.ts`, TypeScript source with an empty list in it.
 * The renderer chooses between the same two states the live page chooses
 * between (src/cms/render/pages/photography.ts): the "currently developing"
 * illustration while there are no albums, and the `.cards--thirds` tile grid
 * once there are. The one change phase 2 asks for is that a tile is now a link
 * to the album's own page (docs/cms-sections.md 3.4), which is why
 * sections.css is here: it holds `.card-link` and nothing the empty state
 * touches.
 */
import Base from '../../layouts/Base.astro';
import '../../cms/styles/sections.css';
import { renderPhotography } from '../../cms/render/index.ts';
import { albums } from '../../lib/site-content.ts';

const body = renderPhotography(albums());
---

<Base title="Photography" description="Photographs by Ryan Choi.">
  <Fragment set:html={body} />
</Base>
