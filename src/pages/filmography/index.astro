---
/**
 * The filmography, from `src/content/data/filmography.json`.
 *
 * Was `src/data/filmography.ts`, which is TypeScript source and so could never
 * be written by an editor (docs/cms-sections.md 1). The markup, the masthead
 * and the poster-frame facade are the renderer's now
 * (src/cms/render/pages/filmography.ts), and the inline click handler that
 * swapped a still for the YouTube player is `initVideoFacades`.
 */
import Base from '../../layouts/Base.astro';
import { renderFilmography } from '../../cms/render/index.ts';
import { films } from '../../lib/site-content.ts';

const body = renderFilmography(films());
---

<Base
  title="Filmography"
  description="Short films Ryan Choi acted in and directed, 2018 to 2019."
>
  <Fragment set:html={body} />
</Base>

<script>
  import { initVideoFacades } from '../../cms/render/video.ts';
  initVideoFacades();
</script>
