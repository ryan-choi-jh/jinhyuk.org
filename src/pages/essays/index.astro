---
/**
 * The essays index, from the metadata of `src/content/pages/essays/*.json`.
 *
 * Was `getCollection('writing')`. The markup, the date format (2026.06.09, to
 * the day) and the empty line are the renderer's now
 * (src/cms/render/pages/ledger.ts), which also sorts newest first, so this
 * page is the data source and nothing else.
 */
import Base from '../../layouts/Base.astro';
import { ledgerItemsFromMetas, renderLedgerPage } from '../../cms/render/index.ts';
import { essayMetas } from '../../lib/site-content.ts';

const body = renderLedgerPage(ledgerItemsFromMetas(essayMetas(), 'essays'), 'essays');
---

<Base title="Essays" description="Essays by Ryan Choi.">
  <Fragment set:html={body} />
</Base>
