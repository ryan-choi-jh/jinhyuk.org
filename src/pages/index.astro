---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getCollection } from 'astro:content';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

// Read the editable home-page content (intro + photo) that Keystatic manages.
const reader = createReader(process.cwd(), keystaticConfig);
const home = await reader.singletons.home.read();

const introParagraphs = (home?.intro ?? '')
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
const photo = home?.photo ?? '/home/ryan.jpg';
const photoAlt = home?.photoAlt ?? 'Ryan Choi';

const posts = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Base description="Ryan (Jin Hyuk) Choi — starting a company in San Francisco, writing in the open.">
  <header class="profile">
    <h1 class="name">Ryan Choi</h1>
    <SocialLinks />
  </header>

  {introParagraphs.map((para) => <p>{para}</p>)}

  {posts.length > 0 && (
    <>
      <h2>Writing</h2>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            <span class="date">{fmt(post.data.date)}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  {photo && (
    <img
      class="about-photo"
      src={photo}
      alt={photoAlt}
      style="image-orientation: from-image;"
      loading="lazy"
      decoding="async"
    />
  )}
</Base>
