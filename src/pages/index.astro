---
/**
 * The homepage, from `src/content/pages/home.json`.
 *
 * Was `src/content/home.yaml` read through the Keystatic reader, with the hero
 * illustration, the enlarge overlay and their script written out here by hand.
 * All four are the renderer's now: `renderDoc` sees `meta.section: "home"` and
 * builds the site's own `.hero`, `.hero-hint`, `.intro` and `.lightbox`
 * (src/cms/render/pages/home.ts), and `initLightboxes` is the inline script
 * from this file, ported into a module the album page shares.
 *
 * doc.css is imported because a band after the hero and the intro renders as
 * an ordinary document (docs/cms-sections.md 3.2). Every one of its rules is
 * scoped under `.doc`, so it cannot reach the hero or the intro.
 */
import Base from '../layouts/Base.astro';
import '../cms/styles/doc.css';
import { renderDoc } from '../cms/render/index.ts';
import { homeDoc } from '../lib/site-content.ts';

const body = renderDoc(homeDoc());
---

<Base description="Ryan (Jin Hyuk) Choi — Korea born, England raised, San Francisco based.">
  <Fragment set:html={body} />
</Base>

<script>
  import { initLightboxes } from '../cms/render/lightbox.ts';
  initLightboxes();
</script>
