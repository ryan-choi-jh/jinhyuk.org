    "title": "Fixture: dense canvas",
    "slug": "fixture-dense",
    "date": "2026-10-08",
    "summary": "The hard case. An overlay band beside prose, rotated media, all five shape kinds, an anchored connector, and four overlapping items in one canvas.",
    "cover": "/projects/track-daily-habit-tracker/blocks/6/value/src.png"
  },
  "bands": [
    {
      "id": "b_dense_prose_1",
      "type": "prose",
      "blocks": [
        {
          "id": "p_dense_intro",
          "kind": "p",
          "content": [
            { "type": "text", "text": "This page exists to break renderers. Everything the document model allows is on it at once, which is the only honest way to find out whether a layout holds." }
          ]
        },
        {
          "id": "h2_dense_build",
          "kind": "h2",
          "content": [{ "type": "text", "text": "Media beside a paragraph" }]
        },
        {
          "id": "p_dense_anchor",
          "kind": "p",
          "content": [
            { "type": "text", "text": "The connector in the margin points at " },
            { "type": "text", "marks": [{ "type": "bold" }], "text": "this paragraph" },
            { "type": "text", "text": ", by id, not by position. Move it, reorder the band, and the line is supposed to follow. It is the one place where the renderer has to measure the real page instead of trusting the stored geometry." }
          ]
        },
        {
          "id": "p_dense_more",
          "kind": "p",
          "content": [
            { "type": "text", "text": "The overlay band next to it reserves no vertical space of its own, so this column of text keeps setting the height and the screenshot off to the right just sits on top of it. On a phone the overlay flag is ignored and the same items drop into flow underneath." }
          ]
        }
      ]
    },
