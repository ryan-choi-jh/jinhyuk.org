---
import '../styles/global.css';
import SocialLinks from '../components/SocialLinks.astro';
import { isNavCurrent, renderCopyright } from '../cms/schema.ts';
import { THEME_ICONS, themeIconArt } from '../cms/site-icons.ts';
import { siteChrome } from '../lib/site-content.ts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

// The whole frame of the site is content, in src/content/data/site.json, edited
// in the CMS under Home and applied here — so to every page at once. That is
// the wordmark, the nav, the theme toggle and the footer. `isNavCurrent`
// derives the highlight from each link's own href rather than a stored match.
const chrome = siteChrome();
const { wordmark, nav, themeToggle } = chrome;

// The wordmark IS the site's name, so the title is built from it rather than
// from a second copy of the same string sitting in this file. Renaming the
// wordmark in the editor renames the tab and the share card with it.
const siteName = wordmark.label;
const fullTitle = title ? `${title} — ${siteName}` : siteName;

const year = new Date().getFullYear();
// Stored as "© {year} Ryan Choi"; the year is filled in at build time, so it
// cannot freeze on whatever year the line was typed in.
const copyright = renderCopyright(chrome.footer.copyright, year);

const path = Astro.url.pathname;
const isCurrent = (href: string) => isNavCurrent(href, path);

// Only carried when it has something to say. `system` is what the site has
// always done and is the script's own default, so the common case puts no
// attribute on <html> at all.
const initialTheme = themeToggle.initial === 'system' ? undefined : themeToggle.initial;
---

<!doctype html>
<html lang="en" data-theme-initial={initialTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="light dark" />

    <!-- Resolve the theme before first paint so there's no flash of the
         wrong one. A visitor's own saved choice always wins; failing that,
         `data-theme-initial` decides, and its absence means follow the OS.
         This restates `resolveInitialTheme` in src/cms/schema.ts, which is
         the version under test — an inline script cannot import. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var initial = root.dataset.themeInitial || 'system';
        try {
          var saved = localStorage.getItem('theme');
          var dark = saved
            ? saved === 'dark'
            : initial === 'system'
              ? window.matchMedia('(prefers-color-scheme: dark)').matches
              : initial === 'dark';
          root.dataset.theme = dark ? 'dark' : 'light';
        } catch (e) {
          // Private browsing: localStorage throws. The setting still applies.
          root.dataset.theme = initial === 'dark' ? 'dark' : 'light';
        }
      })();
    </script>

    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/home/hero.jpg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- No favicon on purpose; the empty data URL stops browsers requesting /favicon.ico. -->
    <link rel="icon" href="data:," />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={siteName} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sarina&family=Bricolage+Grotesque:opsz,wght@12..96,500&family=Inter:ital,wght@0,300;0,400;0,600;0,700;1,300&family=Inter+Tight:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav">
        <a class="wordmark" href={wordmark.href}>{wordmark.label}</a>
        <div class="site-nav-links">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </div>
        {themeToggle.show && (
          <div class="theme-toggle" role="group" aria-label="Colour theme">
            {THEME_ICONS.map((key) => {
              const art = themeIconArt(key);
              return (
                <button type="button" data-theme-set={key} aria-label={art.label}>
                  {/* The artwork is in src/cms/site-icons.ts so the editor's own
                      nav bar can draw this exact control rather than a stand-in. */}
                  <svg viewBox={art.viewBox} aria-hidden="true" focusable="false">
                    {art.parts.map((part) =>
                      part.shape === 'circle' ? (
                        <circle
                          cx={part.cx}
                          cy={part.cy}
                          r={part.r}
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                        />
                      ) : (
                        <path
                          d={part.d}
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap={part.linecap}
                          stroke-linejoin={part.linejoin}
                        />
                      ),
                    )}
                  </svg>
                </button>
              );
            })}
          </div>
        )}
      </nav>
    </header>

    <div class="wrap">
      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span class="copyright">{copyright}</span>
        <SocialLinks />
      </footer>
    </div>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var buttons = document.querySelectorAll('[data-theme-set]');
        var initial = root.dataset.themeInitial || 'system';

        function paint() {
          var current = root.dataset.theme;
          buttons.forEach(function (b) {
            b.setAttribute('aria-pressed', String(b.dataset.themeSet === current));
          });
        }

        function apply(next) {
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch (e) {
            /* private browsing — the choice just won't persist */
          }
          paint();
        }

        /**
         * The switch, as a circular wipe spreading from the button that was
         * pressed — the new theme is revealed over a still snapshot of the old
         * one rather than cross-fading with it. The geometry is in
         * src/styles/global.css (`--theme-r`, `theme-in`); all this does is say
         * where the circle starts and hand the change to the browser to
         * animate.
         *
         * Three ways to end up with the instant switch instead, all of them
         * fine: the visitor asked for less motion, the browser has no View
         * Transitions, or there is no button to spread from.
         */
        function change(next, origin) {
          var reduce = false;
          try {
            reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          } catch (e) {
            /* no matchMedia: treat as no preference */
          }
          if (reduce || !origin || typeof document.startViewTransition !== 'function') {
            apply(next);
            return;
          }
          var box = origin.getBoundingClientRect();
          root.style.setProperty('--vt-x', box.left + box.width / 2 + 'px');
          root.style.setProperty('--vt-y', box.top + box.height / 2 + 'px');
          root.classList.add('theme-vt');
          document
            .startViewTransition(function () {
              apply(next);
            })
            .finished.finally(function () {
              root.classList.remove('theme-vt');
            })
            .catch(function () {
              /* a skipped transition still had its callback run */
            });
        }

        buttons.forEach(function (b) {
          b.addEventListener('click', function () {
            var next = b.dataset.themeSet;
            // Pressing the half that is already lit still pins the choice —
            // that is how someone following their OS says "no, always this
            // one" — but there is nothing to animate, so it doesn't.
            if (root.dataset.theme === next) {
              apply(next);
              return;
            }
            change(next, b);
          });
        });

        // Follow the OS, but only while nobody has overruled it: not when the
        // visitor has picked a side, and not when the site itself names a
        // starting theme.
        try {
          window
            .matchMedia('(prefers-color-scheme: dark)')
            .addEventListener('change', function (e) {
              if (initial !== 'system') return;
              if (localStorage.getItem('theme')) return;
              root.dataset.theme = e.matches ? 'dark' : 'light';
              paint();
            });
        } catch (e) {
          /* older browsers: no live OS switching */
        }

        paint();
      })();
    </script>
  </body>
</html>
