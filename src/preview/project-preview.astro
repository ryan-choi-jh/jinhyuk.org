---
// The live preview behind Keystatic's "Preview" button.
//
// This is not a mock of the project page: it is the project page. It imports
// the same layout and the same renderer, so whatever you see here is what the
// published page will be, including the margin column and the connector
// lines, which only exist once something has real positions in a browser.
//
// It reads from GitHub at the branch you are editing, so it shows the last
// saved state. Unsaved changes in the editor are not in the preview until you
// hit Save.
//
// This route only exists on the Vercel editor deployment. astro.config.mjs
// injects it when PUBLIC_EDITOR_BUILD=1; the static Pages build has no adapter
// and would fail on `prerender = false`.
export const prerender = false;

import Base from '../layouts/Base.astro';
import { createGitHubReader } from '@keystatic/core/reader/github';
import keystaticConfig from '../../keystatic.config';
import { renderProjectBody } from '../lib/project-doc';

const REPO = 'ryan-choi-jh/jinhyuk.org' as const;

const slug = Astro.params.slug!;
const branch = Astro.url.searchParams.get('branch') || 'main';

const reader = createGitHubReader(keystaticConfig, { repo: REPO, ref: branch });

let project: Awaited<ReturnType<typeof reader.collections.projects.read>> = null;
let body = '';
let error: string | null = null;

try {
  project = await reader.collections.projects.read(slug);
  if (project) {
    body = renderProjectBody((await project.content()).node);
  }
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
}

// Images live in public/, which this deployment only has as of its own build.
// Point them at the branch instead, so a picture added in the save you just
// made shows up here rather than 404ing until Vercel rebuilds.
const raw = `https://raw.githubusercontent.com/${REPO}/${branch}/public`;
const onBranch = (html: string) =>
  html.replace(/(src|href)="\/(projects|photography|filmography|home)\//g,
               `$1="${raw}/$2/`);

body = onBranch(body);

const fmt = (d: string) =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

const prettyUrl = (url: string) => {
  try {
    const u = new URL(url);
    return (u.hostname.replace(/^www\./, '') + u.pathname).replace(/\/$/, '');
  } catch {
    return url;
  }
};
---

<Base
  title={project ? `Preview — ${project.title}` : 'Preview'}
  description="Preview"
>
  <div class="preview-flag">
    Preview of <strong>{slug}</strong> on <strong>{branch}</strong>. This is the
    real page, rendered from the last save.
  </div>

  {error && (
    <div class="preview-error">
      <p><strong>Could not read this entry.</strong></p>
      <p>{error}</p>
    </div>
  )}

  {!error && !project && (
    <div class="preview-error">
      <p><strong>Nothing saved at that address yet.</strong></p>
      <p>Save the entry once and the preview will have something to show.</p>
    </div>
  )}

  {project && (
    <>
      <article class="project">
        <h1>{project.title}</h1>
        <p class="post-meta">{fmt(project.date)}</p>

        {project.url && (
          <a class="project-link" href={project.url} target="_blank" rel="noopener noreferrer">
            <span class="project-link-label">Visit</span>
            <span class="project-link-url">{prettyUrl(project.url)}</span>
            <svg class="project-link-arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <path d="M4.5 11.5 11.5 4.5M11.5 4.5H6M11.5 4.5V10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        )}

        {project.summary && <p class="lead project-lead">{project.summary}</p>}
      </article>

      <div class="project-body" set:html={body} />

      <script>
        import { initConnectors } from '../scripts/connectors';
        initConnectors();
      </script>
    </>
  )}
</Base>
