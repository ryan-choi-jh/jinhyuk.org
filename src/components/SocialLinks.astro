---
// The footer's social links, rendered as monochrome icons (they inherit colour
// through currentColor).
//
// The list is content: it lives in src/content/data/site.json and is edited in
// the CMS under Home, so adding, removing or reordering a link is an edit, not
// a deploy. Each entry names its icon by KEY — `github`, `x`, `email` — and the
// drawing for that key comes from src/cms/site-icons.ts. The artwork stays in
// code; nobody is ever asked to paste a bezier into the editor.
import { socialIconArt } from '../cms/site-icons.ts';
import { siteChrome } from '../lib/site-content.ts';

const links = siteChrome().footer.social;
---

<div class="socials">
  {links.map((l) => {
    const art = socialIconArt(l.icon);
    const external = l.href.startsWith('http');
    return (
      <a
        class="social"
        href={l.href}
        aria-label={l.name}
        title={l.name}
        {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        <svg viewBox={art.viewBox} aria-hidden="true" focusable="false">
          <path d={art.path} fill="currentColor" />
        </svg>
      </a>
    );
  })}
</div>
