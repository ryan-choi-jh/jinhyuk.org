# Keystatic GitHub mode (production only).
# These four values are generated the first time you run the site locally and
# visit http://localhost:4321/keystatic to create the Keystatic GitHub App.
# Copy this file to `.env`, paste the values in, and add the same four in Vercel
# (Project Settings → Environment Variables) so editing works on the live site.
#
# Local development uses Keystatic "local mode" and does NOT need these.

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
